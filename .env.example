# Copy to .env on the server. Never commit .env.
SECRET_KEY=PUT_A_LONG_RANDOM_VALUE_HERE          # python -c "import secrets;print(secrets.token_hex(32))"
DATABASE_URL=postgresql+psycopg2://campushub:PASSWORD@localhost:5432/campushub
GEMINI_API_KEY=
GROQ_API_KEY=
GEMINI_MODEL=gemini-3.8-flash                    # change if this model name is rejected
GOOGLE_CLIENT_ID=XXXX.apps.googleusercontent.com # the WEB client id (same one the app uses)
GOOGLE_CLIENT_SECRET=                            # only needed for the old Streamlit/web Google flow
BACKEND_PUBLIC_URL=https://api.yourdomain.com
TOKEN_LIFETIME_HOURS=720
AI_DAILY_LIMIT=30
