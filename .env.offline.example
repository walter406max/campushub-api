# Copy to .env and edit. Never commit .env.

# 1 = fully offline (local SQLite + local Ollama model). 0 = try Gemini/Groq first, Ollama as fallback.
OFFLINE_MODE=1

# Keep a fixed secret so logins survive restarts (generate: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change-me

# Local AI (Ollama)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_NUM_CTX=8192
OLLAMA_TIMEOUT=180

# Optional overrides
# OFFLINE_DATABASE_URL=sqlite:///./campus_sync_offline.db
# CAMPUSHUB_API_PORT=8000
# CAMPUSHUB_UI_PORT=8501

# Only used when OFFLINE_MODE=0
# GEMINI_API_KEY=
# GROQ_API_KEY=
